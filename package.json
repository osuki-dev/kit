{
	"name": "osuki",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"typescript": "^7.0.2",
			"zod": "^4.6.7"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"test": "turbo test",
		"dev:native": "turbo -F native dev",
		"dev:showcase": "turbo -F showcase dev",
		"e2e:native:ios": "bun --filter native e2e:ios",
		"e2e:native:android": "bun --filter native e2e:android",
		"e2e:native:generated:ios": "bun --filter native e2e:generated:ios",
		"e2e:native:generated:android": "bun --filter native e2e:generated:android",
		"e2e:native:replay:ios": "bun --filter native e2e:replay:ios",
		"e2e:native:replay:android": "bun --filter native e2e:replay:android",
		"e2e:generate": "bun --filter native e2e:generate",
		"check:app-contracts": "bun scripts/check-app-contracts.ts",
		"check:changeset-config": "bun scripts/check-changeset-config.ts",
		"check:docs-coverage": "bun scripts/check-docs-coverage.ts",
		"smoke:public-packages": "bun run build:packages && bun scripts/smoke-public-packages.ts",
		"changeset": "changeset",
		"version:packages": "changeset version && bun install --lockfile-only && bun run check",
		"release:packages": "bun run build:packages && changeset publish",
		"check": "oxlint && oxfmt --write && turbo check-types test",
		"check:ci": "oxlint && oxfmt --check && turbo check-types test",
		"deps:check": "syncpack lint --dependency-types prod,dev",
		"deps:fix": "syncpack fix --dependency-types prod,dev",
		"build:packages": "turbo -F @osuki-dev/ui -F @osuki-dev/kit-community build"
	},
	"dependencies": {},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"syncpack": "^15.3.3",
		"turbo": "^2.11.9",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.4.3"
}
