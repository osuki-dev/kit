{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "./src",
		"outDir": "./lib",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		// The package compiles with jsx: "react-native" (JSX preserved) for type
		// checking and for Metro, which handles JSX itself. Published JS must be
		// real JavaScript, so emit with the automatic runtime instead.
		"jsx": "react-jsx",
		// Unused-symbol rules belong to check-types, which runs under the package
		// config. Under react-jsx the explicit React imports it considers used
		// become redundant, and that must not fail the emit.
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "lib"]
}
