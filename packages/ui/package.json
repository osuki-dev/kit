{
	"name": "@osuki-dev/ui",
	"version": "2.0.0-beta.6",
	"private": false,
	"description": "CJK-friendly Expo and React Native UI primitives for Osuki apps.",
	"keywords": [
		"cjk",
		"design-system",
		"expo",
		"react-native",
		"ui"
	],
	"homepage": "https://github.com/osuki-dev/kit/tree/main/packages/ui#readme",
	"bugs": {
		"url": "https://github.com/osuki-dev/kit/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/osuki-dev/kit.git",
		"directory": "packages/ui"
	},
	"files": [
		"CHANGELOG.md",
		"docs",
		"lib",
		"LICENSE",
		"README.md",
		"src/components",
		"src/fonts",
		"src/index.ts",
		"src/navigation",
		"src/theme",
		"src/utils"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"react-native": "./src/index.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"react-native": "./src/index.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		},
		"./theme": {
			"types": "./lib/theme/index.d.ts",
			"react-native": "./src/theme/index.ts",
			"import": "./lib/theme/index.js",
			"default": "./lib/theme/index.js"
		},
		"./components": {
			"types": "./lib/components/index.d.ts",
			"react-native": "./src/components/index.ts",
			"import": "./lib/components/index.js",
			"default": "./lib/components/index.js"
		},
		"./fonts": {
			"types": "./lib/fonts/index.d.ts",
			"react-native": "./src/fonts/index.ts",
			"import": "./lib/fonts/index.js",
			"default": "./lib/fonts/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun src/public-contract.test.ts && bun test src/inline-activity-layout.test.ts && bun test src/surface-fill-overrides.test.ts && bun test src/ai-elements.test.ts && bun test src/icon.test.ts && bun test src/decorator-composition.test.ts && bun test src/core-visual-primitives.test.ts",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"@expo/ui": "~58.0.20",
		"@types/node": "^26.6.5",
		"@types/react": "~19.3.0",
		"expo-image": "~58.0.15",
		"react-native-gesture-handler": "~3.4.0",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@expo/ui": ">=58.0.0",
		"expo-blur": ">=58.0.0",
		"expo-font": ">=58.0.0",
		"expo-glass-effect": ">=58.0.0",
		"expo-image": ">=58.0.0",
		"expo-router": ">=58.0.0",
		"lucide-react-native": "^0.487.0 || ^1.0.0",
		"react": ">=19.3.0",
		"react-native": ">=0.88.0",
		"react-native-gesture-handler": ">=3.4.0",
		"react-native-keyboard-controller": ">=1.22.0",
		"react-native-nano-icons": ">=1.0.0",
		"react-native-reanimated": ">=4.7.0",
		"react-native-safe-area-context": ">=5.10.0",
		"react-native-svg": ">=15.16.0"
	},
	"peerDependenciesMeta": {
		"expo-blur": {
			"optional": true
		},
		"expo-glass-effect": {
			"optional": true
		},
		"lucide-react-native": {
			"optional": true
		},
		"react-native-nano-icons": {
			"optional": true
		},
		"react-native-svg": {
			"optional": true
		}
	}
}
