{
	"name": "native",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"dev": "expo start --clear",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"prebuild": "expo prebuild",
		"web": "expo start --web",
		"check-types": "tsc --noEmit",
		"sim": "serve-sim",
		"sim:detach": "serve-sim --detach",
		"sim:kill": "serve-sim --kill",
		"brand:assets": "node ./script/generate-brand-assets.mjs",
		"test": "bun run test:data",
		"test:data": "bun test lib/data",
		"e2e:generate": "node ./e2e/generate-agent-device-flows.mjs",
		"e2e": "bun run e2e:ios && bun run e2e:android",
		"e2e:ios": "node ./e2e/run-agent-device.mjs maestro ios smoke",
		"e2e:android": "node ./e2e/run-agent-device.mjs maestro android smoke",
		"e2e:ios:record": "node ./e2e/run-agent-device.mjs maestro ios smoke -- --record-video",
		"e2e:android:record": "node ./e2e/run-agent-device.mjs maestro android smoke -- --record-video",
		"e2e:generated:ios": "bun run e2e:generate && node ./e2e/run-agent-device.mjs generated ios",
		"e2e:generated:android": "bun run e2e:generate && node ./e2e/run-agent-device.mjs generated android",
		"e2e:replay:ios": "node ./e2e/run-agent-device.mjs replay ios",
		"e2e:replay:android": "node ./e2e/run-agent-device.mjs replay android"
	},
	"dependencies": {
		"@expo-google-fonts/noto-sans": "^0.4.2",
		"@expo-google-fonts/noto-sans-jp": "^0.4.4",
		"@expo-google-fonts/noto-sans-sc": "^0.4.4",
		"@expo/ui": "~58.0.20",
		"@legendapp/list": "^3.6.0",
		"@osuki-dev/kit-community": "workspace:*",
		"@osuki-dev/ui": "workspace:*",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.3",
		"expo": "~58.0.14",
		"expo-auth-session": "~58.0.13",
		"expo-blur": "~58.0.4",
		"expo-build-properties": "~58.0.11",
		"expo-constants": "~58.0.12",
		"expo-crypto": "~58.0.7",
		"expo-dev-client": "~58.0.14",
		"expo-font": "~58.0.8",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.15",
		"expo-linear-gradient": "~58.0.3",
		"expo-linking": "~58.0.13",
		"expo-network": "~58.0.3",
		"expo-router": "~58.0.23",
		"expo-secure-store": "~58.0.2",
		"expo-splash-screen": "~58.0.10",
		"expo-sqlite": "~58.0.13",
		"expo-status-bar": "~58.0.3",
		"expo-system-ui": "~58.0.6",
		"expo-web-browser": "~58.0.6",
		"lucide-react-native": "^1.58.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.4.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-nitro-fetch": "^1.9.0",
		"react-native-nitro-modules": "^0.37.1",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@types/react": "~19.3.0",
		"connect": "^3.7.0",
		"serve-sim": "^0.1.48",
		"typescript": "catalog:"
	},
	"expo": {
		"install": {
			"exclude": [
				"react",
				"react-dom",
				"react-native-gesture-handler",
				"typescript"
			]
		}
	}
}
