{
	"name": "native",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"dev": "expo start --clear",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"prebuild": "expo prebuild",
		"web": "expo start --web",
		"check-types": "tsc --noEmit",
		"sim": "serve-sim",
		"sim:detach": "serve-sim --detach",
		"sim:kill": "serve-sim --kill",
		"brand:assets": "node ./script/generate-brand-assets.mjs",
		"test": "bun run test:data",
		"test:data": "bun test lib/data",
		"e2e:generate": "node ./e2e/generate-agent-device-flows.mjs",
		"e2e": "bun run e2e:ios && bun run e2e:android",
		"e2e:ios": "node ./e2e/run-agent-device.mjs maestro ios smoke",
		"e2e:android": "node ./e2e/run-agent-device.mjs maestro android smoke",
		"e2e:ios:record": "node ./e2e/run-agent-device.mjs maestro ios smoke -- --record-video",
		"e2e:android:record": "node ./e2e/run-agent-device.mjs maestro android smoke -- --record-video",
		"e2e:generated:ios": "bun run e2e:generate && node ./e2e/run-agent-device.mjs generated ios",
		"e2e:generated:android": "bun run e2e:generate && node ./e2e/run-agent-device.mjs generated android",
		"e2e:replay:ios": "node ./e2e/run-agent-device.mjs replay ios",
		"e2e:replay:android": "node ./e2e/run-agent-device.mjs replay android"
	},
	"dependencies": {
		"@expo-google-fonts/noto-sans": "^0.4.2",
		"@expo-google-fonts/noto-sans-jp": "^0.4.3",
		"@expo-google-fonts/noto-sans-sc": "^0.4.3",
		"@expo/ui": "~57.0.8",
		"@expo/vector-icons": "^15.0.2",
		"@legendapp/list": "^3.3.2",
		"@osuki-dev/kit-community": "workspace:*",
		"@osuki-dev/ui": "^0.2.0",
		"@tanstack/react-query": "^5.101.2",
		"expo": "~57.0.9",
		"expo-auth-session": "~57.0.5",
		"expo-blur": "~57.0.2",
		"expo-build-properties": "~57.0.8",
		"expo-constants": "~57.0.8",
		"expo-crypto": "~57.0.1",
		"expo-dev-client": "~57.0.10",
		"expo-font": "~57.0.1",
		"expo-haptics": "~57.0.1",
		"expo-image": "~57.0.1",
		"expo-linear-gradient": "~57.0.1",
		"expo-linking": "~57.0.4",
		"expo-network": "~57.0.1",
		"expo-router": "~57.0.9",
		"expo-secure-store": "~57.0.1",
		"expo-splash-screen": "~57.0.5",
		"expo-sqlite": "~57.0.1",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.2",
		"expo-web-browser": "~57.0.2",
		"lucide-react-native": "^1.24.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.2",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-nitro-fetch": "^1.5.0",
		"react-native-nitro-modules": "^0.35.10",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-web": "^0.21.0",
		"react-native-worklets": "0.10.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@types/react": "~19.2.17",
		"connect": "^3.7.0",
		"serve-sim": "^0.1.44",
		"typescript": "catalog:"
	}
}
