{
	"expo": {
		"name": "Osuki Market",
		"slug": "osuki",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "osuki",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "dev.osuki.kit",
			"privacyManifests": {
				"NSPrivacyAccessedAPITypes": [
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
						"NSPrivacyAccessedAPITypeReasons": ["0A2A.1", "3B52.1", "C617.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
						"NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
						"NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
						"NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
					}
				],
				"NSPrivacyCollectedDataTypes": [],
				"NSPrivacyTracking": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#FCFBFA",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "dev.osuki.kit"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#FCFBFA",
					"dark": {
						"backgroundColor": "#050B12"
					}
				}
			],
			[
				"expo-font",
				{
					"fonts": [
						"./node_modules/@expo-google-fonts/noto-sans/400Regular/NotoSans_400Regular.ttf",
						"./node_modules/@expo-google-fonts/noto-sans/500Medium/NotoSans_500Medium.ttf",
						"./node_modules/@expo-google-fonts/noto-sans/700Bold/NotoSans_700Bold.ttf",
						"./node_modules/@expo-google-fonts/noto-sans-jp/400Regular/NotoSansJP_400Regular.ttf",
						"./node_modules/@expo-google-fonts/noto-sans-jp/500Medium/NotoSansJP_500Medium.ttf",
						"./node_modules/@expo-google-fonts/noto-sans-jp/700Bold/NotoSansJP_700Bold.ttf",
						"./node_modules/@expo-google-fonts/noto-sans-sc/400Regular/NotoSansSC_400Regular.ttf",
						"./node_modules/@expo-google-fonts/noto-sans-sc/500Medium/NotoSansSC_500Medium.ttf",
						"./node_modules/@expo-google-fonts/noto-sans-sc/700Bold/NotoSansSC_700Bold.ttf"
					]
				}
			],
			"expo-secure-store",
			"expo-web-browser",
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "16.4"
					}
				}
			],
			"expo-image",
			"expo-sqlite",
			"expo-status-bar"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
